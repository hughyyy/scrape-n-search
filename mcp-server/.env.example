# API keys for the unified providers. Set the ones you want enabled.
# The MCP server auto-selects the first enabled provider that supports the tool,
# and fails over to the next on error. Override selection order with PROVIDER_PRIORITY.

# Recommended stack
TINYFISH_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
ZENROWS_API_KEY=
SCRAPPEY_API_KEY=
FIRECRAWL_API_KEY=

# Optional / cheap / fallback
SERPER_API_KEY=
# Jina fetch (r.jina.ai) works without a key; Jina search (s.jina.ai) requires a key.
JINA_API_KEY=

# Comma-separated provider names, highest priority first, e.g.:
# PROVIDER_PRIORITY=tinyfish,tavily,exa,zenrows,scrappey,firecrawl,serper,jina

# Default provider used when a tool call does not pass `provider`.
# When set, tools the provider cannot serve are HIDDEN from the client.
# Scrappey supports fetch only -> with this set, only web_fetch is exposed.
DEFAULT_PROVIDER=scrappey

# HTTP timeout (seconds) for provider API calls. Default 60 (connect 15).
# Scrappey browser requests take 20-40s; raise this (e.g. 120) for long
# web_browser_actions sequences.
# HTTP_TIMEOUT=120

# TTL (seconds) for cached web_fetch results. Repeated identical fetches are
# served from the router cache instead of billing the provider. 0 = off (default).
# CACHE_TTL=300

# Explicit allow-list of tool names (web_search, web_fetch, web_browser_actions,
# web_screenshot, web_crawl, web_extract).
# Overrides the set derived from DEFAULT_PROVIDER. Unset = all (minus any the
# default provider cannot serve).
# ENABLED_TOOLS=web_fetch,web_browser_actions,web_screenshot

# Jina is enabled without a key (free, no anti-bot bypass). Set 0 to disable.
# JINA_KEYLESS=1
