# API keys for the unified providers. Set the ones you want enabled.
# The MCP server auto-selects the first enabled provider that supports the tool,
# and fails over to the next on error. Override selection order with PROVIDER_PRIORITY.

# Recommended stack
TINYFISH_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
ZENROWS_API_KEY=
SCRAPPEY_API_KEY=
FIRECRAWL_API_KEY=

# Optional / cheap / fallback
SERPER_API_KEY=
# Jina fetch (r.jina.ai) works without a key; Jina search (s.jina.ai) requires a key.
JINA_API_KEY=

# Comma-separated provider names, highest priority first, e.g.:
# PROVIDER_PRIORITY=tinyfish,tavily,exa,zenrows,scrappey,firecrawl,serper,jina

# Emulated web_extract (Scrappey-only setups): the page is summarized by an
# LLM call, so an LLM key must be reachable by the server. The key is picked
# up from the process environment first — a harness (Oh My Pi) can inject it
# via the mcp.json `env` block, same mechanism as look-n-see:
#   "env": { "OPENROUTER_API_KEY": "!/path/to/omp token openrouter", ... }
# — or set it here. OPENROUTER_API_KEY wins over HF_TOKEN.
# OPENROUTER_API_KEY=
# HF_TOKEN=
# Model for the emulated extract call (defaults: OpenRouter
# deepseek/deepseek-chat, HuggingFace deepseek-ai/DeepSeek-V4-Flash-0731).
# EXTRACT_MODEL=
# Page text cap (chars) sent to the LLM per extract call. Default 100000.
# Must be a positive integer; an invalid value fails at startup.
# EXTRACT_MAX_CHARS=

# Default provider used when a tool call does not pass `provider`. Optional:
# leave it unset to auto-select in PROVIDER_PRIORITY order, or set it to a
# provider whose key is configured (an unconfigured default is a startup error).
# When set, tools the provider cannot serve are HIDDEN from the client, except
# web_search/web_crawl/web_extract: an enabled Scrappey keeps those visible so
# its emulation (search/crawl/extract) can be offered behind the force gate.
# DEFAULT_PROVIDER=scrappey

# HTTP timeout (seconds) for provider API calls. Default 60 (connect 15).
# Scrappey browser requests take 20-40s; raise this (e.g. 120) for long
# web_browser_actions sequences.
# HTTP_TIMEOUT=120

# TTL (seconds) for cached web_fetch results. Repeated identical fetches are
# served from the router cache instead of billing the provider. 0 = off (default).
# CACHE_TTL=300

# Log verbosity: DEBUG, INFO (default), WARNING, ERROR, CRITICAL.
# INFO logs which provider served each tool call; DEBUG adds cache hits.
# LOG_LEVEL=INFO

# Explicit allow-list of tool names (web_search, web_fetch, web_browser_actions,
# web_screenshot, web_crawl, web_extract, web_session).
# Overrides the set derived from DEFAULT_PROVIDER. Unset = all (minus any the
# default provider cannot serve).
# ENABLED_TOOLS=web_fetch,web_browser_actions,web_screenshot,web_session

# Jina is enabled without a key (free, no anti-bot bypass). Set 0 to disable.
# JINA_KEYLESS=1
